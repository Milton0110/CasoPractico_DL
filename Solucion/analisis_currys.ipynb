    "## 4. Función de Limpieza\n",
    "\n",
    "Construimos la función de limpieza basada en lo observado: URLs, caracteres no-ASCII/emojis, puntuación y espacios múltiples."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "b4c5d6e7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=== TEST clean_text ===\n",
      "ANTES : Great product! https://currys.co.uk was amazing 😊\n",
      "DESPUÉS: great product was amazing\n",
      "\n",
      "ANTES : TERRIBLE service... called 3 times, NO answer!!!\n",
      "DESPUÉS: terrible service called 3 times no answer\n",
      "\n",
      "ANTES :   Arrived on  time,  very  happy   \n",
      "DESPUÉS: arrived on time very happy\n",
      "\n"
     ]
    }
   ],
   "source": [
    "def clean_text(text: str) -> str:\n",
    "    \"\"\"\n",
    "    Limpieza estándar de texto para vectorización TF-IDF.\n",
    "    NO se aplica al modelo de sentimiento (BERT tokeniza internamente).\n",
    "    \"\"\"\n",
    "    if not isinstance(text, str) or len(text.strip()) == 0:\n",
    "        return \"\"\n",
    "    text = text.lower()                              # minúsculas\n",
    "    text = re.sub(r'http\\S+|www\\.\\S+', '', text)    # eliminar URLs\n",
    "    text = re.sub(r'[^a-z0-9\\s]', ' ', text)        # solo letras, números, espacios\n",
    "    text = re.sub(r'\\s+', ' ', text).strip()         # normalizar espacios\n",
    "    return text\n",
    "\n",
    "\n",
    "# Test rápido\n",
    "test_cases = [\n",
    "    \"Great product! https://currys.co.uk was amazing 😊\",\n",
    "    \"TERRIBLE service... called 3 times, NO answer!!!\",\n",
    "    \"  Arrived on  time,  very  happy   \",\n",
    "]\n",
    "print(\"=== TEST clean_text ===\")\n",
    "for t in test_cases:\n",
    "    print(f\"ANTES : {t}\")\n",
    "    print(f\"DESPUÉS: {clean_text(t)}\")\n",
    "    print()"
   ]
  },
