    "    \"\"\"Normaliza etiquetas a negative/neutral/positive.\"\"\"\n",
    "    label_lower = label.lower()\n",
    "    return LABEL_MAP.get(label_lower, label_lower)\n",
    "\n",
    "\n",
    "print(\"Aplicando sentimiento a todas las reseñas...\")\n",
    "texts = df['review'].fillna('').astype(str).tolist()\n",
    "raw_results = sentiment_pipe(texts)\n",
    "\n",
    "df['sentiment']       = [normalize_label(r['label']) for r in raw_results]\n",
    "df['sentiment_score'] = [r['score'] for r in raw_results]\n",
    "\n",
    "print(\"\\n✓ Sentimiento calculado.\")\n",
    "print(\"Distribución global:\")\n",
    "print(df['sentiment'].value_counts().to_string())"
